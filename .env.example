# Optional overrides for the sales data source.
# By default the app reads the LEAP sales sheet (already shared as "anyone with the link can view")
# via its CSV export endpoint. Override only if you point this at a different sheet.

# Full CSV export URL (takes precedence over SHEET_ID/SHEET_GID below).
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/XXXXX/export?format=csv

# Or override just the sheet id / tab (gid) and keep the default export URL shape.
# SHEET_ID=1b3UFDTyn5gegoKbj_29yYOH9q57CuTLqlf3A0nDlYU8
# SHEET_GID=0

# Goals ("Controle de Metas" tab): month, empresa, comercial, and one column
# per vendedor (e.g. Lucas, Anderson). Same override options as above.
# GOALS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/XXXXX/export?format=csv&gid=406321113
# GOALS_SHEET_GID=406321113
